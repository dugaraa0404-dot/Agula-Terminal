// Cloudflare deployment: a tiny Worker (worker/index.js) in front of one container
// that runs agula.py. Deploy with:  npm install  &&  npx wrangler deploy
// Requires the Workers Paid plan and Docker running on your computer.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agula-terminal",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-27",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "AgulaContainer",
      "image": "./Dockerfile",
      // One instance on purpose: every visitor shares one in-memory cache.
      "max_instances": 1,
      // basic = 1/4 vCPU, 1 GiB memory. Use standard-1 (1/2 vCPU, 4 GiB) if pages feel slow.
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "AgulaContainer", "name": "AGULA" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgulaContainer"] }]
}
