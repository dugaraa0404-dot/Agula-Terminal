# Local runs: copy to .env (next to agula.py). Never commit .env.
# On Render, set these in the dashboard. On Cloudflare: npx wrangler secret put NAME

# Optional: free key from https://fred.stlouisfed.org/docs/api/api_key.html (official release calendar)
FRED_API_KEY=

# Optional: protect the paper-trading bots (BOT) on a public server. When set, only
# browsers that enter this token in SET can create, stop or trade bots.
AGULA_BOT_TOKEN=
# Where paper bots are saved (default: ./agula-data next to agula.py). Use a persistent disk on servers.
AGULA_DATA_DIR=
# Seconds between paper-bot checks (default 30). AGULA_BOTS=0 turns the engine off.
AGULA_BOT_TICK=30
